# ===================================================================
# WTMA — TELEGRAM BOT & NOTIFICATION SOZLAMALARI (.env)
# ===================================================================

# 1. Telegram Bot Token (@BotFather orqali yaratilgan bot tokeni)
# Misol: 7123456789:AAFlq1X2Y3Z4_abcdef...
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Botning shaxsiy chat ID-si (Alohida foydalanuvchi / Admin ID)
# Bu yerga bot bilan shaxsiy chatda zayavkani qabul qiluvchi admin ID-si kiritiladi.
# ID-ni bilish uchun Telegramda @userinfobot yoki @getmyid_bot ga /start yuboring.
# Misol: 123456789
TELEGRAM_CHAT_ID=your_personal_chat_id_here

# 3. Telegram Guruh ID-si (Ochiq yoki YOPIQ guruh / kanal)
# DIQQAT: Yopiq guruhlarga bot xabar yuborishi uchun:
#   a) Botni yopiq guruhga qo'shib, unga Administrator (Admin) huquqini bering!
#   b) Yopiq guruh ID-si doim minus va 100 bilan boshlanadi (masalan: -1001987654321).
# 💡 Guruh ID-sini oson bilish:
#   Botni yopiq guruhga qo'shib, guruhda birorta so'z yozing va terminalda:
#   node test-telegram.js --find buyrug'ini bering — ID darhol chiqadi!
# Misol: -1001987654321
TELEGRAM_GROUP_ID=your_group_chat_id_here

# 3.1. Guruhdagi Topic / Mavzu ID-si (Ixtiyoriy)
# Agar yopiq guruhingizda Forum (Topics / Mavzular) yoqilgan bo'lsa, zayavkalar tushadigan mavzu ID-si:
TELEGRAM_GROUP_THREAD_ID=

# 4. Qo'shimcha chat ID lar (Ixtiyoriy, vergul bilan ajratilgan)
# Agar bir vaqtning o'zida bir nechta boshqa guruh yoki xodimlarga ham yuborish kerak bo'lsa:
# Misol: 987654321,-1001122334455
TELEGRAM_EXTRA_CHAT_IDS=

# 5. Ichki API Server Porti (Standart: 3000)
PORT=3000
